# скопируй в .env и заполни своими данными — .env никогда не коммитится

# базовый URL и ключ провайдера DeepSeek (OpenAI-совместимый chat/completions)
DEEPSEEK_API_BASE_URL=
DEEPSEEK_API_KEY=

# модель для обычного чата — можно переключить на pro одной переменной
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# модель для /api/memory/extract — всегда самый дешёвый тир,
# независимо от того, что стоит в DEEPSEEK_CHAT_MODEL
DEEPSEEK_MEMORY_MODEL=deepseek-v4-flash

# токен телеграм-бота (Mini App + long-polling + Telegram Stars)
TELEGRAM_BOT_TOKEN=

# origin фронтенда для CORS и кнопок Mini App в боте (например, https://bro.example.com)
FRONTEND_ORIGIN=

# ключ для защищённого GET /admin/stats
ADMIN_KEY=

# необязательно: persistent volume для users.json / events.log в проде
# DATA_DIR=

PORT=8787
